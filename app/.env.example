# Skopiuj do .env.local i uzupełnij. Plik .env.local NIE trafia do repozytorium.

# ─── Claude API (generowanie raportu) ────────────────────────────────────────
# Klucz z https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=
# Model do raportu. Domyślnie Claude Sonnet 5.5 (tańszy). Obsługuje też zdjęcia.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Głębokość rozumowania: low | medium | high | xhigh | max (więcej = drożej i wolniej).
ANTHROPIC_EFFORT=medium
# Limit tokenów odpowiedzi (raport + rozumowanie).
ANTHROPIC_MAX_TOKENS=32000
# 0 = wyłącza serwerowy fallback na inny model, gdy model odmówi odpowiedzi.
ANTHROPIC_FALLBACK=1
# off = nie wysyłaj parametru thinking (tylko dla starszych modeli sprzed 4.6).
ANTHROPIC_THINKING=adaptive

# Atrapa AI: 1 = raport przykładowy bez wywołania API (testy bez klucza).
AI_MOCK=0
# Sztuczne opóźnienie atrapy w ms (żeby zobaczyć ekran „generujemy…”).
AI_MOCK_DELAY_MS=2500

# ─── Płatności (Stripe Checkout: BLIK, Przelewy24, karta) ─────────────────────
# 1 = pomija Stripe i od razu generuje raport. TYLKO do testów – nigdy w produkcji!
DEV_SKIP_PAYMENT=0
# Klucz tajny Stripe (sk_test_… do testów, sk_live_… w produkcji).
STRIPE_SECRET_KEY=
# Sekret podpisu webhooka (whsec_…) – z Dashboard → Webhooks albo `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# Ceny w groszach.
PRICE_RAPORT_GR=1900
PRICE_RAPORT_PLUS_GR=2900
# Publiczny adres serwisu (do powrotu z płatności). Bez ukośnika na końcu.
APP_URL=http://localhost:3000

# ─── Linki afiliacyjne (sekcja „Chcesz sprawdzić historię z zagranicy?”) ──────
# Puste = sekcja ukryta.
AFFILIATE_AUTODNA_URL=
AFFILIATE_CARVERTICAL_URL=

# ─── Dane i przechowywanie ───────────────────────────────────────────────────
# Plik bazy SQLite (domyślnie data/app.db w katalogu app/).
# DATABASE_PATH=./data/app.db
# Katalog bazy modeli (domyślnie ../data/models względem app/).
# MODELS_DIR=../data/models
# 1 = dołącz przykładowy model z fixtures/ (do testów, gdy baza jest pusta). W produkcji 0.
MODELS_INCLUDE_FIXTURES=0
# Plik z heurystykami czerwonych flag (domyślnie ../data/red-flags.json).
# RED_FLAGS_PATH=../data/red-flags.json
# Ile minut trzymać zdjęcia w pamięci w oczekiwaniu na płatność.
IMAGE_CACHE_TTL_MIN=120
