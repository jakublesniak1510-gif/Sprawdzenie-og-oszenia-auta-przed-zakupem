# Skopiuj do .env.local i uzupełnij. Plik .env.local NIE trafia do repozytorium.

# ─── Claude API (generowanie raportu) ────────────────────────────────────────
# Klucz z https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=
# Model do raportu. Domyślnie Claude Sonnet 5.5 (tańszy). Obsługuje też zdjęcia.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Głębokość rozumowania: low | medium | high | xhigh | max (więcej = drożej i wolniej).
ANTHROPIC_EFFORT=medium
# Limit tokenów odpowiedzi (raport + rozumowanie).
ANTHROPIC_MAX_TOKENS=32000
# 0 = wyłącza serwerowy fallback na inny model, gdy model odmówi odpowiedzi.
ANTHROPIC_FALLBACK=1
# off = nie wysyłaj parametru thinking (tylko dla starszych modeli sprzed 4.6).
ANTHROPIC_THINKING=adaptive

# Atrapa AI: 1 = raport przykładowy bez wywołania API (testy bez klucza).
AI_MOCK=0
# Sztuczne opóźnienie atrapy w ms (żeby zobaczyć ekran „generujemy…”).
AI_MOCK_DELAY_MS=2500

# ─── Płatności (Stripe Checkout: BLIK, Przelewy24, karta) ─────────────────────
# 1 = pomija Stripe i od razu generuje raport. TYLKO do testów – nigdy w produkcji!
DEV_SKIP_PAYMENT=0
# Klucz tajny Stripe (sk_test_… do testów, sk_live_… w produkcji).
STRIPE_SECRET_KEY=
# Sekret podpisu webhooka (whsec_…) – z Dashboard → Webhooks albo `stripe listen`.
STRIPE_WEBHOOK_SECRET=
# 1 (domyślnie) = druga opłacona sesja za ten sam raport jest automatycznie zwracana przez Stripe (+ alert w logu).
AUTO_REFUND_DUPLICATE=1
# Ceny w groszach.
PRICE_RAPORT_GR=1900
PRICE_RAPORT_PLUS_GR=2900
# Pakiet 5 raportów (kupon na 5 raportów „Raport”, ważny 365 dni).
PRICE_PAKIET5_GR=4900
# Publiczny adres serwisu (do powrotu z płatności). Bez ukośnika na końcu.
APP_URL=http://localhost:3000

# ─── Linki afiliacyjne (sekcja „Chcesz sprawdzić historię z zagranicy?”) ──────
# Puste = sekcja ukryta.
AFFILIATE_AUTODNA_URL=
AFFILIATE_CARVERTICAL_URL=

# ─── Dane i przechowywanie ───────────────────────────────────────────────────
# Plik bazy SQLite (domyślnie data/app.db w katalogu app/).
# DATABASE_PATH=./data/app.db
# Katalog bazy modeli (domyślnie ../data/models względem app/).
# MODELS_DIR=../data/models
# 1 = dołącz przykładowy model z fixtures/ (do testów, gdy baza jest pusta). W produkcji 0.
MODELS_INCLUDE_FIXTURES=0
# Plik z heurystykami czerwonych flag (domyślnie ../data/red-flags.json).
# RED_FLAGS_PATH=../data/red-flags.json
# Zdjęcia czekają na wygenerowanie raportu na dysku, zaszyfrowane AES-256-GCM (usuwane po raporcie, max 48 h).
# Klucz: 64 znaki hex – wygeneruj: openssl rand -hex 32. WYMAGANY w produkcji (bez niego serwer nie wystartuje).
# W dev, gdy pusty, aplikacja tworzy klucz deweloperski w data/images/.dev-key.
IMAGE_ENCRYPTION_KEY=
# Katalog zdjęć (domyślnie data/images w katalogu app/).
# IMAGES_DIR=./data/images

# ─── Generowanie raportów (kolejka) ──────────────────────────────────────────
# Ile raportów generować równolegle.
GENERATION_CONCURRENCY=2
# Po ilu minutach raport „generating” uznajemy za przerwany (wznowienie po restarcie).
GENERATION_STALE_MIN=10
# Opóźnienie ponowienia po błędzie przejściowym (ms × numer próby). Maks. 3 próby.
GENERATION_RETRY_DELAY_MS=30000

# ─── E-mail ──────────────────────────────────────────────────────────────────
# resend | smtp | none (none = nic nie wysyła, tylko loguje).
EMAIL_PROVIDER=none
# Nadawca (domena musi być zweryfikowana u dostawcy).
EMAIL_FROM="Sprawdź Ogłoszenie <raporty@twojadomena.pl>"
# Adres do odpowiedzi (opcjonalnie).
EMAIL_REPLY_TO=
# Resend (https://resend.com → API Keys).
RESEND_API_KEY=
# SMTP (np. skrzynka w hostingu poczty). SMTP_SECURE=1 dla portu 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=0
# Katalog treści e-maili (*.md) – domyślnie ../content/emails; brak pliku = treść wbudowana.
# EMAIL_CONTENT_DIR=../content/emails

# ─── Bezpieczeństwo ──────────────────────────────────────────────────────────
# 1 = aplikacja stoi za reverse proxy (Caddy/nginx) i ufa nagłówkom X-Real-IP / ostatniemu elementowi X-Forwarded-For
# (rate limit, analityka). Bez proxy zostaw 0 – inaczej każdy może podać dowolne IP.
TRUST_PROXY=0
# 1 = wyłącza rate limit (tylko testy lokalne).
RATE_LIMIT_DISABLED=0
# W produkcji start serwera blokują: DEV_SKIP_PAYMENT=1, AI_MOCK=1, RATE_LIMIT_DISABLED=1, brak IMAGE_ENCRYPTION_KEY,
# pusty APP_URL lub APP_URL / NEXT_PUBLIC_BASE_URL wskazujący na localhost.
# 1 = pozwól mimo to (np. serwer demonstracyjny). NIGDY na prawdziwej produkcji.
ALLOW_UNSAFE_PROD=0

# ─── Panel admina (/admin, Basic Auth) ───────────────────────────────────────
# Oba puste = panel wyłączony (404).
ADMIN_USER=
ADMIN_PASSWORD=
