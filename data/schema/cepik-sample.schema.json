{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cepik-sample.schema.json",
  "title": "Oczekiwany wynik parsowania próbki wklejonej Historii Pojazdu (samples/cepik/*.expected.json)",
  "type": "object",
  "required": ["plik", "hipotetyczny_format", "opis", "odczyty", "pierwszaRejestracja", "pierwszaRejestracjaPl", "cofniecia", "sygnaly", "uwagi"],
  "additionalProperties": false,
  "$defs": {
    "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "odczyt": {
      "type": "object",
      "required": ["data", "km"],
      "additionalProperties": false,
      "properties": { "data": { "$ref": "#/$defs/data" }, "km": { "type": "integer", "minimum": 0 } }
    }
  },
  "properties": {
    "plik": { "type": "string", "description": "nazwa pliku .txt z próbką" },
    "hipotetyczny_format": { "type": "boolean", "description": "true = brzmienie komunikatów niepotwierdzone w usłudze" },
    "opis": { "type": "string" },
    "vin": { "type": "string", "pattern": "^[A-HJ-NPR-Z0-9]{17}$", "description": "fikcyjny VIN (zaczyna się od TEST)" },
    "odczyty": { "type": "array", "items": { "$ref": "#/$defs/odczyt" }, "description": "odczyty drogomierza posortowane rosnąco po dacie" },
    "pierwszaRejestracja": { "anyOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }], "description": "pierwsza rejestracja gdziekolwiek" },
    "pierwszaRejestracjaPl": { "anyOf": [{ "$ref": "#/$defs/data" }, { "type": "null" }], "description": "pierwsza rejestracja w Polsce; null, gdy tekst tego nie rozstrzyga" },
    "cofniecia": {
      "type": "array",
      "items": { "type": "object", "required": ["z", "na"], "additionalProperties": false, "properties": { "z": { "$ref": "#/$defs/odczyt" }, "na": { "$ref": "#/$defs/odczyt" } } }
    },
    "sygnaly": {
      "type": "array",
      "items": { "type": "string", "enum": ["cofniecie_przebiegu", "import", "brak_historii_przed_importem", "przerwa_w_badaniach", "brak_oc_w_okresie", "kradziez_w_historii", "wyrejestrowany", "brak_aktualnego_oc", "brak_aktualnego_badania", "badanie_dodatkowe", "zmiana_wlasciciela", "wlasciciel_firma"] },
      "description": "znormalizowane sygnały, które parser/raport powinien wychwycić"
    },
    "uwagi": { "type": "array", "items": { "type": "string" }, "description": "opis po polsku, co powinno trafić do raportu (neutralnie)" }
  }
}
