{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model.schema.json",
  "title": "Baza typowych usterek – jeden model (generacja)",
  "type": "object",
  "required": ["id", "make", "model", "generation", "years", "aliases", "engines", "common_faults", "inspection_tips", "questions_for_seller", "summary"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "slug, np. vw-golf-7" },
    "make": { "type": "string" },
    "model": { "type": "string" },
    "generation": { "type": "string", "description": "np. VII (2012–2020)" },
    "years": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "aliases": { "type": "array", "items": { "type": "string" }, "description": "małe litery, warianty z ogłoszeń: 'golf 7', 'golf vii', 'golf mk7'" },
    "market_note": { "type": "string", "description": "krótko: pozycja na rynku PL, typowe ceny, na co uważać ogólnie" },
    "price_ranges": {
      "type": "array",
      "minItems": 1,
      "description": "opcjonalne: orientacyjne widełki cen rynkowych w Polsce (bieżący rok, ceny ofertowe) dla typowych egzemplarzy – stan dobry, bez wypadku, przebieg do km_max; 3–5 przedziałów po rocznikach. Na tym polu działa flaga „cena poniżej rynku”",
      "items": {
        "type": "object",
        "required": ["years", "km_max", "price_pln"],
        "additionalProperties": false,
        "properties": {
          "years": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2, "description": "[od, do] – roczniki objęte widełkami (włącznie)" },
          "km_max": { "type": "integer", "minimum": 0, "description": "górna granica typowego przebiegu dla tych widełek; wyższy przebieg zwykle obniża cenę" },
          "price_pln": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2, "description": "[od, do] w PLN – typowe ceny ofertowe" },
          "note": { "type": "string", "description": "co przesuwa cenę, np. 'diesle 2.0 TDI o 10–15% drożej'" }
        }
      }
    },
    "running_costs": {
      "type": "object",
      "required": ["oc_ac_note", "service_interval_km", "typical_parts_note"],
      "additionalProperties": false,
      "description": "opcjonalne: orientacyjne koszty utrzymania (bieżący rok, warsztat niezależny)",
      "properties": {
        "oc_ac_note": { "type": "string", "description": "orientacyjne OC/AC; składka zależy głównie od kierowcy i miejsca zamieszkania" },
        "service_interval_km": { "type": "integer", "minimum": 1000, "description": "zalecany w praktyce (nie fabryczny LongLife) interwał wymiany oleju w km" },
        "typical_parts_note": { "type": "string", "description": "dostępność i ceny typowych części i obsługi" }
      }
    },
    "buy_advice": {
      "type": "object",
      "required": ["best_pick", "avoid", "sweet_spot_years"],
      "additionalProperties": false,
      "description": "opcjonalne: krótka rada zakupowa",
      "properties": {
        "best_pick": { "type": "string", "description": "najrozsądniejszy wariant (silnik, skrzynia, roczniki)" },
        "avoid": { "type": "string", "description": "czego unikać lub co wymaga szczególnej weryfikacji" },
        "sweet_spot_years": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2, "description": "[od, do] – roczniki o najlepszym stosunku ceny do ryzyka" }
      }
    },
    "engines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["code", "fuel", "aliases", "faults"],
        "properties": {
          "code": { "type": "string", "description": "np. 1.6 TDI CR (CLHA/CXXB)" },
          "fuel": { "type": "string", "enum": ["benzyna", "diesel", "lpg", "hybryda", "elektryk"] },
          "power_hp": { "type": "array", "items": { "type": "integer" } },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "timing": { "type": "string", "description": "rozrząd: pasek/łańcuch, interwał, koszt" },
          "verdict": { "type": "string", "enum": ["polecany", "neutralny", "ryzykowny"] },
          "faults": {
            "type": "array",
            "minItems": 2,
            "items": { "$ref": "#/$defs/fault" }
          }
        }
      }
    },
    "common_faults": { "type": "array", "items": { "$ref": "#/$defs/fault" }, "description": "usterki niezależne od silnika: zawieszenie, elektryka, nadwozie, skrzynie (DSG!), korozja" },
    "inspection_tips": { "type": "array", "items": { "type": "string" }, "description": "konkretne rzeczy do sprawdzenia na oględzinach tego modelu" },
    "questions_for_seller": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string", "description": "2–4 zdania: ogólna ocena, najlepsze i najgorsze warianty" },
    "sources_note": { "type": "string", "description": "skąd wiedza (ogólnie: fora, serwisy, doświadczenie warsztatowe) – bez linków do konkretnych stron" }
  },
  "$defs": {
    "fault": {
      "type": "object",
      "required": ["title", "symptoms", "severity", "cost_pln", "check_at_inspection"],
      "properties": {
        "title": { "type": "string" },
        "symptoms": { "type": "string" },
        "mileage_km": { "type": "string", "description": "orientacyjnie kiedy, np. '150–250 tys.'" },
        "severity": { "type": "string", "enum": ["niska", "srednia", "wysoka"] },
        "cost_pln": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2, "description": "[od, do] w PLN, ceny warsztat niezależny 2026" },
        "check_at_inspection": { "type": "string", "description": "jak to sprawdzić przed zakupem" }
      }
    }
  }
}
